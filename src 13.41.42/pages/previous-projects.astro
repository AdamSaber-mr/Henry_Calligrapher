---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/content';

---

<Layout
  title="Previous Projects — Henry Calligraphy"
  description="A selection of bespoke calligraphy, engraving and hot foil projects by Henry Calligraphy."
>
  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <p class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-muted-foreground">
        Portfolio
      </p>
      <h1 class="mt-5 font-serif text-4xl leading-tight md:text-6xl">Previous projects</h1>
      <p class="mx-auto mt-6 max-w-2xl font-sans text-sm leading-relaxed text-muted-foreground">
        A glimpse into recent commissions — from wedding stationery and live event personalisation
        to engraved gifts and foiled details.
      </p>
    </div>
  </section>

  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <h2 class="font-serif text-2xl md:text-3xl">Selected commissions</h2>
      <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <article class="group">
              <div
                class="relative overflow-hidden bg-secondary h-72 w-full"
                role="img"
                aria-label={`${project.title} — ${project.tag}`}
              >
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,var(--color-background),transparent_70%)] opacity-70" />
                <div class="absolute inset-3 border border-border" />
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="px-6 text-center font-sans text-[0.65rem] uppercase tracking-[0.35em] text-muted-foreground">
                    {project.title} — {project.tag}
                  </span>
                </div>
              </div>
              <div class="mt-5 flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-xl">{project.title}</h3>
                <span class="shrink-0 font-sans text-[0.6rem] uppercase tracking-[0.25em] text-accent">
                  {project.tag}
                </span>
              </div>
              <p class="mt-2 font-sans text-sm leading-relaxed text-muted-foreground">
                {project.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
