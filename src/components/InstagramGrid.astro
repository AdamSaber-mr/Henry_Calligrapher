---
/**
 * Static replica of the Elfsight Instagram feed widget used on the original site.
 * Tiles are 4:5 with a 1px gutter, matching the widget's rendered layout.
 */
const profile = 'https://www.instagram.com/henrycalligraphy/';
const posts = [1, 2, 3, 4, 5, 6, 7, 8];
---

<div class="mt-10">
  <ul class="grid grid-cols-2 gap-px sm:grid-cols-4">
    {
      posts.map((n) => (
        <li>
          <a href={profile} target="_blank" rel="noopener noreferrer">
            <img
              src={`/images/instagram/post-${n}.jpg`}
              alt="Instagram post by Henry Calligraphy"
              loading="lazy"
              class="aspect-[4/5] w-full object-cover"
            />
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 text-center">
    <a
      href={profile}
      target="_blank"
      rel="noopener noreferrer"
      class="font-sans text-xs text-foreground transition-colors hover:text-accent"
      >See More Posts</a
    >
  </div>
</div>
