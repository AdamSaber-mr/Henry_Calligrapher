---
import { Image } from 'astro:assets';
import { gallery } from '../../data/content';
import { img } from '../../lib/images';

const items = gallery.map((item) => ({ ...item, image: img(item.file) }));
const lightboxSources = items.map((item) => ({ src: item.image.src, alt: item.alt }));

const navButton =
  'absolute top-1/2 z-10 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70';
---

<div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" id="gallery">
  {
    items.map((item, index) => (
      <figure data-reveal data-reveal-delay={(index % 5) * 70}>
        <button
          type="button"
          data-lightbox-index={index}
          class="group relative block w-full overflow-hidden rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          aria-label={`Open ${item.alt} in lightbox`}
        >
          <Image
            src={item.image}
            alt={item.alt}
            widths={[320, 480, 720]}
            sizes="(min-width: 1024px) 13rem, (min-width: 640px) 30vw, 45vw"
            class="aspect-square w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <span class="absolute inset-0 bg-foreground/0 transition-colors duration-300 group-hover:bg-foreground/10" />
        </button>
        <figcaption class="mt-3 font-sans text-[0.7rem] uppercase tracking-[0.16em] text-muted-foreground">
          {item.alt}
        </figcaption>
      </figure>
    ))
  }
</div>

<div
  id="lightbox"
  hidden
  class="fixed inset-0 z-[70] flex items-center justify-center bg-foreground/95 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Image gallery lightbox"
>
  <button
    type="button"
    data-lightbox-close
    class="absolute right-4 top-4 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
    aria-label="Close lightbox"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      class="h-6 w-6"
      aria-hidden="true"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <button type="button" data-lightbox-prev class={`left-4 ${navButton}`} aria-label="Previous image">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-6 w-6"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>

  <button type="button" data-lightbox-next class={`right-4 ${navButton}`} aria-label="Next image">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-6 w-6"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>

  <div class="max-h-[85vh] max-w-[92vw]" data-lightbox-stage>
    <img
      data-lightbox-image
      src=""
      alt=""
      class="max-h-[78vh] max-w-[92vw] rounded-xl object-contain"
    />
    <p data-lightbox-caption class="mt-4 text-center font-sans text-sm text-white/80"></p>
  </div>
</div>

<script define:vars={{ sources: lightboxSources }}>
  const lightbox = document.getElementById('lightbox');
  const grid = document.getElementById('gallery');

  if (lightbox && grid) {
    const image = lightbox.querySelector('[data-lightbox-image]');
    const caption = lightbox.querySelector('[data-lightbox-caption]');
    const stage = lightbox.querySelector('[data-lightbox-stage]');
    const closeBtn = lightbox.querySelector('[data-lightbox-close]');
    let current = 0;
    let opener = null;

    const render = () => {
      const item = sources[current];
      image.src = item.src;
      image.alt = item.alt;
      caption.textContent = `${item.alt} — ${current + 1} / ${sources.length}`;
    };

    const open = (index, trigger) => {
      current = index;
      opener = trigger;
      render();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    };

    const step = (delta) => {
      current = (current + delta + sources.length) % sources.length;
      render();
    };

    for (const button of grid.querySelectorAll('[data-lightbox-index]')) {
      button.addEventListener('click', () => open(Number(button.dataset.lightboxIndex), button));
    }

    lightbox.addEventListener('click', close);
    stage.addEventListener('click', (event) => event.stopPropagation());
    closeBtn.addEventListener('click', close);
    lightbox.querySelector('[data-lightbox-prev]').addEventListener('click', (event) => {
      event.stopPropagation();
      step(-1);
    });
    lightbox.querySelector('[data-lightbox-next]').addEventListener('click', (event) => {
      event.stopPropagation();
      step(1);
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowRight') step(1);
      if (event.key === 'ArrowLeft') step(-1);
      // Keep focus inside the dialog.
      if (event.key === 'Tab') {
        event.preventDefault();
        closeBtn.focus();
      }
    });
  }
</script>
