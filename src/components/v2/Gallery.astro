---
import { Image } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import { gallery } from '../../data/content';
import { img } from '../../lib/images';

/**
 * Image grid backed by a lightbox. Defaults to the Pétalia collection, but takes any set —
 * `id` must be unique per instance so several galleries can share a page.
 */
type GalleryItem = { file: string; alt: string; credit?: string };

interface Props {
  items?: GalleryItem[];
  id?: string;
  captions?: boolean;
}

const { id = 'gallery', captions = true } = Astro.props;
const source: GalleryItem[] = Astro.props.items ?? gallery;

const items = source.map((item) => ({ ...item, image: img(item.file) }));
const lightboxSources = items.map((item) => ({
  src: item.image.src,
  alt: item.alt,
  credit: item.credit,
}));
const lightboxId = `${id}-lightbox`;
---

<div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" id={id}>
  {
    items.map((item, index) => (
      <figure data-reveal data-reveal-delay={(index % 5) * 70}>
        <button
          type="button"
          data-lightbox-open={lightboxId}
          data-lightbox-index={index}
          class="group relative block w-full overflow-hidden rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          aria-label={`Open ${item.alt} in lightbox`}
        >
          <Image
            src={item.image}
            alt={item.alt}
            widths={[320, 480, 720]}
            sizes="(min-width: 1024px) 13rem, (min-width: 640px) 30vw, 45vw"
            class="aspect-square w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <span class="absolute inset-0 bg-foreground/0 transition-colors duration-300 group-hover:bg-foreground/10" />
        </button>
        {captions && (
          <figcaption class="mt-3 font-sans text-[0.7rem] uppercase tracking-[0.16em] text-muted-foreground">
            {item.alt}
          </figcaption>
        )}
      </figure>
    ))
  }
</div>

<Lightbox id={lightboxId} sources={lightboxSources} />
