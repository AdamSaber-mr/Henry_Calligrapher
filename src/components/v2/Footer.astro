---
import { Image } from 'astro:assets';
import { email, instagramUrl, navLinks, tagline } from '../../data/content';
import { img } from '../../lib/images';

const wordmark = img('henry-wordmark-alpha.png');
const v2Href: Record<string, string> = { '/#inquiry': '/v2/contact' };
const toV2 = (href: string) => v2Href[href] ?? `/v2${href}`;

const explore = [
  ...navLinks.map((l) => ({ href: toV2(l.href), label: l.label })),
  { href: '/v2/petalia', label: 'Pétalia Collection' },
];

const linkClass = 'transition-colors hover:text-accent';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-foreground/10">
  <div class="mx-auto max-w-6xl px-5 py-section sm:px-6">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Image
          src={wordmark}
          alt="Henry Calligraphy"
          widths={[280, 560]}
          sizes="220px"
          class="h-14 w-auto"
          loading="lazy"
        />
        <p class="mt-6 max-w-sm font-serif text-xl italic leading-snug text-foreground/75">
          {tagline}
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-sans text-[0.7rem] uppercase tracking-[0.25em] text-muted-foreground">
          Explore
        </h2>
        <ul class="mt-5 space-y-3 font-sans text-[0.95rem]">
          {
            explore.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-sans text-[0.7rem] uppercase tracking-[0.25em] text-muted-foreground">
          Contact
        </h2>
        <ul class="mt-5 space-y-3 font-sans text-[0.95rem]">
          <li>Isha Henry-Hament · Calligrapher</li>
          <li><a href={`mailto:${email}`} class={linkClass}>{email}</a></li>
          <li>Breda, the Netherlands</li>
          <li>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
              @henrycalligraphy
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-foreground/10 pt-8 font-sans text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Henry Calligraphy</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/v2/cookie-policy" class={linkClass}>Cookie Policy</a>
        <a href="/v2/terms-and-conditions" class={linkClass}>Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>
