---
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'outline' | 'onDark' | 'heroOutline';
  /** `smMd` is small on a phone and full size from lg, without touching the desktop look. */
  size?: 'sm' | 'md' | 'smMd';
  class?: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  external = false,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-sans uppercase tracking-[0.18em] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';

const sizes = {
  sm: 'px-5 py-2.5 text-[0.7rem]',
  md: 'px-7 py-3.5 text-[0.75rem]',
  smMd: 'px-5 py-2.5 text-[0.7rem] lg:px-7 lg:py-3.5 lg:text-[0.75rem]',
};

const variants = {
  primary:
    'bg-foreground text-background hover:-translate-y-0.5 hover:shadow-lift focus-visible:ring-offset-background',
  accent:
    'bg-accent text-accent-foreground hover:-translate-y-0.5 hover:shadow-lift focus-visible:ring-offset-background',
  outline:
    'border border-foreground/25 text-foreground hover:border-foreground hover:bg-foreground hover:text-background focus-visible:ring-offset-background',
  onDark:
    'border border-background/40 text-background hover:bg-background hover:text-foreground focus-visible:ring-offset-foreground',
  /* Sits on the photograph below lg and on the cream page from lg up. The lg: utilities are
     emitted inside a media query, so they reliably win over the mobile ones. */
  heroOutline:
    'border border-background/60 text-background hover:bg-background hover:text-foreground lg:border-foreground/25 lg:text-foreground lg:hover:bg-foreground lg:hover:text-background focus-visible:ring-offset-background',
};

const rel = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class={`${base} ${sizes[size]} ${variants[variant]} ${className}`} {...rel}>
  <slot />
</a>
