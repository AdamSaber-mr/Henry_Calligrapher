---
import Section from './Section.astro';
import { credentials } from '../../data/content';
---

<Section tone="muted" compact>
  <ul class="grid grid-cols-2 gap-x-8 gap-y-9 lg:grid-cols-4">
    {
      credentials.map((item, i) => (
        <li data-reveal data-reveal-delay={i * 70}>
          <p class="font-sans text-eyebrow uppercase tracking-[0.22em] text-muted-foreground">
            {item.label}
          </p>
          <p class="mt-2 font-serif text-lg leading-snug">{item.value}</p>
        </li>
      ))
    }
  </ul>
</Section>
