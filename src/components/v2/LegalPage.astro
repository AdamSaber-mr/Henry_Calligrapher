---
import PageHeader from './PageHeader.astro';

interface Props {
  title: string;
  sections: { id: string; heading: string }[];
  updated: string;
}

const { title, sections, updated } = Astro.props;
---

<PageHeader eyebrow="Legal" title={title} />

<section>
  <div class="mx-auto max-w-6xl px-5 py-section sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[16rem_1fr] lg:gap-16">
      <nav aria-label="On this page" class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <h2 class="font-sans text-[0.65rem] uppercase tracking-[0.25em] text-muted-foreground">
          On this page
        </h2>
        <ol class="mt-5 space-y-2.5 font-sans text-[0.9rem]">
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="text-muted-foreground transition-colors hover:text-accent"
                >
                  {section.heading}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="max-w-prose" data-reveal data-reveal-delay="80">
        <div class="space-y-10 font-sans text-[1.0625rem] leading-relaxed text-muted-foreground">
          <slot />
        </div>
        <p class="mt-12 border-t border-foreground/10 pt-6 font-sans text-xs text-muted-foreground/70">
          Last updated: {updated}
        </p>
      </div>
    </div>
  </div>
</section>
