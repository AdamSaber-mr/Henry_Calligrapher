---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { homeServices } from '../../data/content';
import { img } from '../../lib/images';

const cards = homeServices.map((service) => ({ ...service, image: img(service.file) }));
---

<Section id="services">
  <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
    <div class="max-w-2xl">
      <p class="font-sans text-eyebrow uppercase tracking-[0.24em] text-muted-foreground">
        What I do
      </p>
      <h2 class="mt-4 font-serif text-headline">Together we elevate the setting</h2>
    </div>
    <a
      href="/v2/services"
      class="font-sans text-eyebrow uppercase tracking-[0.2em] text-accent transition-colors hover:text-foreground"
    >
      All services
    </a>
  </div>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <article class="group flex flex-col" data-reveal data-reveal-delay={i * 90}>
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={card.image}
              alt={card.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
              class={`aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105 ${card.position}`}
              loading="lazy"
            />
          </div>
          <h3 class="mt-6 font-serif text-title">{card.titleV2 ?? card.title}</h3>
          <ul class="mt-4 space-y-2.5 font-sans text-body text-muted-foreground">
            {card.items.map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-3 h-px w-4 shrink-0 bg-accent" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
