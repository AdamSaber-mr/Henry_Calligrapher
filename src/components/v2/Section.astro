---
/**
 * The single section frame for v2.
 *
 * Every section on the site renders through this, so the divider between any two sections is
 * identical by construction. Hand-rolled `border-t` / `border-b` mixes were what made the
 * How-it-works → contact transition read as if a line were missing.
 */
interface Props {
  id?: string;
  /** `dark` inverts the band; `muted` is the warm sand tint used for the credentials strip. */
  tone?: 'default' | 'muted' | 'dark';
  width?: '6xl' | '3xl' | '4xl';
  /** Turn the top rule off for the first section on a page, which sits right under the header. */
  divider?: boolean;
  /** Tighter vertical padding, for compact bands like the contact call to action. */
  compact?: boolean;
  class?: string;
}

const {
  id,
  tone = 'default',
  width = '6xl',
  divider = true,
  compact = false,
  class: className = '',
} = Astro.props;

const tones = {
  default: '',
  muted: 'bg-secondary/60',
  dark: 'bg-foreground text-background',
};

const widths = {
  '3xl': 'max-w-3xl',
  '4xl': 'max-w-4xl',
  '6xl': 'max-w-6xl',
};

const padding = compact ? 'py-10 sm:py-12 lg:py-14' : 'py-section';
---

<section
  id={id}
  class:list={[divider && 'border-t border-foreground/10', tones[tone], className]}
>
  <div class={`mx-auto ${widths[width]} px-5 ${padding} sm:px-6`}>
    <slot />
  </div>
</section>
