---
import { navLinks } from '../data/content';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const linkClass =
  'font-sans text-[0.65rem] uppercase tracking-[0.28em] text-muted-foreground transition-colors hover:text-accent';

const links = navLinks;

const isHome = pathname === '/';
---

<header class="sticky top-0 z-50 border-y border-foreground/20 bg-background/90 backdrop-blur">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-3 md:flex-row md:items-center md:justify-between"
  >
    <a class="flex items-center" href="/" aria-current={isHome ? 'page' : undefined}>
      <img
        src="/images/henry-wordmark.png"
        alt="Henry Calligraphy"
        class="h-12 w-auto mix-blend-multiply md:h-14"
      />
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1">
        {
          links.map((link) => {
            const active = pathname === link.match;
            return (
              <li>
                <a
                  href={link.href}
                  class={active ? `${linkClass} text-accent` : linkClass}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href="/petalia"
            class="inline-flex items-center rounded-full bg-accent px-4 py-1.5 font-sans text-[0.65rem] uppercase tracking-[0.2em] text-accent-foreground transition-transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background"
            aria-current={pathname === '/petalia' ? 'page' : undefined}
          >
            Pétalia Collection
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
