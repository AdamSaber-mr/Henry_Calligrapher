---
import Button from './Button.astro';
import Section from './Section.astro';

interface Props {
  /** Anchor target, so links like `/#inquiry` land on this band. */
  id?: string;
}

const { id } = Astro.props;
---

<Section tone="dark" compact id={id}>
  <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
    <div class="max-w-xl" data-reveal>
      <p class="font-sans text-eyebrow uppercase tracking-[0.24em] text-background/60">
        Commissions
      </p>
      <h2 class="mt-2 font-serif text-title sm:text-headline">Inquire for price</h2>
      <p class="mt-3 max-w-lg font-sans text-body text-background/75 sm:text-lead">
        Every commission is quoted individually — tell me about the occasion, the pieces and the
        date, and you'll receive a tailored proposal.
      </p>
    </div>
    <div class="shrink-0" data-reveal data-reveal-delay="80">
      <Button href="/contact" variant="onDark">Get in touch</Button>
    </div>
  </div>
</Section>
