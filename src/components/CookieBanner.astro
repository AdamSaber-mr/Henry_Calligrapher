---
---

<div
  id="cookie-consent"
  role="dialog"
  aria-label="Cookie consent"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-foreground/10 bg-background/95 p-6 shadow-lg backdrop-blur-sm md:bottom-6 md:left-6 md:right-auto md:max-w-md md:rounded-lg md:border"
>
  <div class="space-y-4">
    <p class="text-sm leading-relaxed text-foreground">
      We use cookies to improve your browsing experience. Essential cookies are always active. You
      can choose whether to allow optional cookies. <a
        href="/cookie-policy"
        class="underline underline-offset-2 transition-colors hover:text-accent"
        >Read our Cookie Policy</a
      >.
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        data-consent="accepted"
        class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >Accept</button
      >
      <button
        type="button"
        data-consent="declined"
        class="inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent"
        >Decline</button
      >
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'hc-cookie-consent';
  const banner = document.getElementById('cookie-consent');

  if (banner) {
    let stored: string | null = null;
    try {
      stored = window.localStorage.getItem(STORAGE_KEY);
    } catch {
      stored = null;
    }

    if (stored !== 'accepted' && stored !== 'declined') {
      banner.hidden = false;
    }

    for (const button of banner.querySelectorAll<HTMLButtonElement>('[data-consent]')) {
      button.addEventListener('click', () => {
        try {
          window.localStorage.setItem(STORAGE_KEY, button.dataset.consent!);
        } catch {
          /* storage unavailable — just dismiss */
        }
        banner.hidden = true;
      });
    }
  }
</script>
