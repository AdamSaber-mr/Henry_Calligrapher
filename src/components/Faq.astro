---
import Section from './Section.astro';
import Button from './Button.astro';
import { faq } from '../data/content';

/* Eight questions is a long list on a phone. The first four cover the questions people ask
   most; the rest stay one tap away rather than being dropped. */
const VISIBLE_ON_MOBILE = 4;
---

<Section id="faq">
  <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="font-sans text-eyebrow uppercase tracking-[0.24em] text-muted-foreground">
        Good to know
      </p>
      <h2 class="mt-4 font-serif text-headline">Frequently asked</h2>
      <p class="mt-5 max-w-sm font-sans text-lead text-muted-foreground">
        The practical side of a bespoke commission — quotes, payment, turnaround and what happens if
        plans change.
      </p>

      <div class="mt-9 rounded-2xl border border-foreground/15 bg-card p-6">
        <h3 class="font-serif text-lg">Still have questions?</h3>
        <p class="mt-2 font-sans text-body text-muted-foreground">
          Ask directly and you'll get a straight answer.
        </p>
        <div class="mt-5">
          <Button href="/contact" variant="outline" size="smMd">Get in touch</Button>
        </div>
      </div>
    </div>

    <div data-faq>
      <div class="divide-y divide-foreground/10 border-y border-foreground/10">
        {
          faq.map((item, i) => (
            <details
              class:list={['group', i >= VISIBLE_ON_MOBILE && 'faq-extra']}
              data-reveal
            >
              <summary class="flex min-h-[3.5rem] cursor-pointer list-none items-center justify-between gap-6 py-5 font-serif text-title transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  class="h-5 w-5 shrink-0 text-accent transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </summary>
              <p class="pb-6 font-sans text-body text-muted-foreground">{item.a}</p>
            </details>
          ))
        }
      </div>

      <button
        type="button"
        class="faq-toggle mt-5 items-center gap-2 font-sans text-eyebrow uppercase tracking-[0.2em] text-accent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-expanded="false"
      >
        <span data-faq-label>All {faq.length} questions</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="faq-chevron h-4 w-4"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</Section>

<script>
  /* Authored with every question in the markup, so without JavaScript the full list shows
     and the button never appears — the CSS that hides the extras is scoped to html.js. */
  const block = document.querySelector<HTMLElement>('[data-faq]');
  const button = block?.querySelector<HTMLButtonElement>('.faq-toggle');
  const label = block?.querySelector<HTMLElement>('[data-faq-label]');
  const total = block?.querySelectorAll('details').length ?? 0;

  if (block && button && label) {
    button.addEventListener('click', () => {
      const open = block.toggleAttribute('data-faq-open');
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Fewer questions' : `All ${total} questions`;
      if (!open) block.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  }
</script>
