---
import Layout from '../layouts/Layout.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import { homeServices, mailto } from '../data/content';

const description =
  'Hand-lettered wedding stationery, live event calligraphy, engraving and hot foil by Isha Henry-Hament, calligrapher based in Breda, the Netherlands.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Henry Calligraphy',
  description,
  url: 'https://henrycalligraphy.lovable.app/',
  founder: { '@type': 'Person', name: 'Isha Henry-Hament' },
  address: { '@type': 'PostalAddress', addressLocality: 'Breda', addressCountry: 'NL' },
  areaServed: ['Breda', 'Netherlands'],
  knowsAbout: [
    'Copperplate calligraphy',
    'Wedding stationery',
    'Live event calligraphy',
    'Engraving',
    'Hot foil',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      'Bespoke wedding stationery',
      'Live event calligraphy',
      'Engraving',
      'Hot foil',
      'Private calligraphy lessons',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};

const services = homeServices.map((service) => ({
  ...service,
  image: `/images/${service.file}`,
}));

const inquiryMailto = mailto.commission;
---

<Layout
  title="Henry Calligraphy — Bespoke Copperplate Calligraphy in Breda"
  description={description}
  jsonLd={jsonLd}
>
  <section id="top" class="relative border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center md:py-32">
      <img
        src="/images/henry-wordmark.png"
        alt="Henry Calligraphy logo"
        class="mx-auto mb-10 w-56 mix-blend-multiply md:w-72"
      />
      <div class="mx-auto mt-8 h-px w-12 bg-accent" aria-hidden="true"></div>
      <h1 class="mx-auto mt-8 max-w-4xl font-serif text-4xl leading-[1.1] md:text-6xl">
        <span class="block font-sans text-[0.6rem] uppercase tracking-[0.35em] text-muted-foreground"
          >Bespoke copperplate calligraphy in Breda</span
        >
        <span class="mt-6 block text-3xl md:text-5xl"
          >There’s a distinctive warmth, that only handwritten notes seem to deliver.</span
        >
      </h1>
    </div>
  </section>

  <section id="services" class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <h2 class="font-serif text-3xl leading-tight md:text-5xl">Together we elevate the setting</h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3">
        {
          services.map((service) => (
            <article>
              <img
                src={service.image}
                alt={service.alt}
                class={`aspect-[4/3] w-full object-cover sm:h-56 sm:aspect-auto ${service.position}`}
              />
              <h3 class="mt-6 font-serif text-2xl">{service.title}</h3>
              <ul class="mt-4 space-y-2 font-sans text-sm text-muted-foreground">
                {service.items.map((item) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-2 h-px w-4 shrink-0 bg-accent" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="previous-projects" class="border-b border-foreground/15">
    <div class="relative mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-x-14 gap-y-8 md:grid-cols-2 md:grid-rows-[auto_auto_auto]">
        <div class="grid md:grid-rows-subgrid md:row-span-3">
          <h2 class="font-serif text-3xl md:text-4xl">Live calligraphy</h2>
          <p class="mt-4 font-sans text-sm leading-relaxed text-muted-foreground md:mt-0">
            On-site at your event: guests watch their names, bottles or bags being personalised in
            ink. A memorable detail for brand activations, weddings and private celebrations.
          </p>
          <img
            src="/images/live-waxseal.jpg"
            alt="Live calligraphy — pouring a wax seal onto a hand-lettered envelope"
            class="mt-8 aspect-[4/3] w-full object-cover object-[50%_68%] sm:aspect-auto sm:h-56 md:mt-0"
          />
        </div>
        <div class="grid md:grid-rows-subgrid md:row-span-3">
          <h2 class="font-serif text-3xl md:text-4xl">Studio orders</h2>
          <p class="mt-4 font-sans text-sm leading-relaxed text-muted-foreground md:mt-0">
            Written and finished in the studio, then delivered to your door: invitation suites,
            engraved gifts and foiled stationery, crafted at the pace good work requires.
          </p>
          <img
            src="/images/studio-orders.jpg"
            alt="Studio order — hand-lettered welcome card among fresh flowers"
            class="mt-8 aspect-[4/3] w-full object-cover object-[65%_45%] sm:aspect-auto sm:h-56 md:mt-0"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="inquiry" class="border-b border-foreground/15 bg-foreground text-background">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <h2 class="mx-auto max-w-3xl font-serif text-4xl leading-tight md:text-6xl">
        Inquire for price
      </h2>
      <p class="mx-auto mt-6 max-w-lg font-sans text-sm leading-relaxed opacity-75">
        Every commission is quoted individually — tell me about the occasion, the pieces and the
        date, and you'll receive a tailored proposal.
      </p>
      <a
        href={inquiryMailto}
        class="mt-10 inline-flex items-center border border-background px-8 py-3 font-sans text-[0.65rem] uppercase tracking-[0.3em] transition-colors hover:bg-background hover:text-foreground"
        >Commission inquiry</a
      >
    </div>
  </section>

  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p
        class="text-center font-sans text-[0.6rem] uppercase tracking-[0.45em] text-muted-foreground"
      >
        Trusted by
      </p>
      <ul class="mt-8 grid grid-cols-2 gap-8 md:grid-cols-4">
        {
          [0, 1, 2, 3].map(() => (
            <li class="flex h-14 items-center justify-center border border-border font-serif text-sm tracking-[0.2em] text-muted-foreground">
              Client name
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-serif text-3xl md:text-4xl">Latest from the studio</h2>
        <a
          href="https://www.instagram.com/henrycalligraphy/"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-accent pb-1 font-sans text-[0.65rem] uppercase tracking-[0.3em] text-accent"
          >@henrycalligraphy</a
        >
      </div>
      <InstagramGrid />
    </div>
  </section>
</Layout>
