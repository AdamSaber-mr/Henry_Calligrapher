---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import ContactBanner from '../components/ContactBanner.astro';
import ReadMore from '../components/ReadMore.astro';
import { img } from '../lib/images';

const products = [
  {
    title: 'Tricolore Oysters',
    image: img('tricolore-oysters.jpg'),
    alt: 'Tricolore Oysters — hand-lettered oyster shells in a wooden gift box',
    reversed: false,
    body: [
      'Make your event even more memorable with our signature oyster placecards. A memory, quote or a name, hand-lettered in classic copperplate script. Each oyster scrubbed, treated, prepped and painted entirely by hand. We begin with an iridescent white base, allowing the oyster’s natural inner hues to beautifully glow through. It is then finished using our signature Tricolore painting method – a delicate combination of yellow gold, bronze gold, and silver paint. The result is a touch of sparkle and glamour with a nostalgic charm, transforming each oyster into a truly unique keepsake.',
    ],
    note: 'Presented in a chic wooden gift box.',
    collapse: true,
  },
  {
    title: 'Personalised Notebooks',
    image: img('personalized-notebooks.jpg'),
    alt: 'Personalised black notebook with Henry Calligraphy embossed in gold',
    reversed: true,
    body: [
      'A timeless, black, high quality Sakura notebook, hand-foiled with your name, initials or your favorite quote. A personal gift to others or to yourself.',
    ],
    note: 'The perfect day-to-day tool, made extra special through calligraphy.',
    collapse: false,
  },
];
---

<Layout
  title="Products — Henry Calligraphy"
  description="Bespoke calligraphy products and paper goods by Henry Calligraphy. Carefully crafted, personalised, and ready to elevate your moments."
>
  <PageHeader
    eyebrow="Bespoke goods"
    title="Products"
    lead="A curated selection of personalised products and paper goods, each designed to add a personal, handcrafted touch to your everyday moments and celebrations."
  />

  {
    products.map((product) => (
      <section class="border-b border-foreground/10">
        <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-section sm:px-6 lg:grid-cols-2 lg:gap-16">
          <div class={`overflow-hidden rounded-2xl ${product.reversed ? 'lg:order-2' : ''}`} data-reveal>
            <Image
              src={product.image}
              alt={product.alt}
              widths={[560, 840, 1120]}
              sizes="(min-width: 1024px) 32rem, 92vw"
              class="aspect-[4/5] w-full object-cover object-center transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class={product.reversed ? 'lg:order-1' : ''} data-reveal data-reveal-delay="100">
            <h2 class="font-serif text-headline">{product.title}</h2>
            <ReadMore class="mt-6" maxHeight={product.collapse ? '12rem' : '100rem'}>
              <div class="space-y-4 font-sans text-lead text-muted-foreground">
                {product.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                <p class="font-medium text-foreground">{product.note}</p>
              </div>
            </ReadMore>
            <div class="mt-9">
              <Button href="/contact?subject=product#form" variant="outline">
                Inquire about {product.title}
              </Button>
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <ContactBanner />
</Layout>
