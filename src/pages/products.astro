---
import Layout from '../layouts/Layout.astro';
import { mailto } from '../data/content';

const productMailto = mailto.product;

const ctaClass =
  'mt-8 inline-flex items-center border border-foreground px-8 py-3 font-sans text-[0.65rem] uppercase tracking-[0.3em] transition-colors hover:bg-foreground hover:text-background';
---

<Layout
  title="Products — Henry Calligraphy"
  description="Bespoke calligraphy products and paper goods by Henry Calligraphy. Carefully crafted, personalised, and ready to elevate your moments."
>
  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <p class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-muted-foreground">
        Bespoke goods
      </p>
      <h1 class="mt-5 font-serif text-4xl leading-tight md:text-6xl">Products</h1>
      <p class="mx-auto mt-6 max-w-2xl font-sans text-sm leading-relaxed text-muted-foreground">
        A curated selection of calligraphy-based products and paper goods, each designed to add a
        personal, handcrafted touch to your everyday moments and celebrations.
      </p>
    </div>
  </section>

  <section class="border-b border-foreground/15">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2 md:items-center">
      <img
        src="/images/tricolore-oysters.jpg"
        alt="Tricolore Oysters — hand-lettered oyster shells in a wooden gift box"
        class="aspect-[3/4] w-full object-cover object-center sm:aspect-auto sm:h-96 md:h-[28rem]"
      />
      <div>
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Tricolore Oysters</h2>
        <div class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-muted-foreground">
          <p>
            Make your event even more memorable with our signature oyster placecards. A memory,
            quote or a name, hand-lettered in classic copperplate script. Each oyster scrubbed,
            treated, prepped and painted entirely by hand. We begin with an iridescent white base,
            allowing the oyster’s natural inner hues to beautifully glow through. It is then
            finished using our signature Tricolore painting method – a delicate combination of
            yellow gold, bronze gold, and silver paing. The result is a touch of sparkle and glamour
            with a nostalgic charm, transforming each oyster into a truly unique keepsake.
          </p>
          <p class="font-medium text-foreground">Presented in a chic wooden gift box.</p>
        </div>
        <a href={productMailto} class={ctaClass}>Inquire about Tricolore Oysters</a>
      </div>
    </div>
  </section>

  <section class="border-b border-foreground/15">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2 md:items-center">
      <div class="order-2 md:order-1">
        <h2 class="font-serif text-3xl leading-tight md:text-4xl">Personalised Notebooks</h2>
        <div class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-muted-foreground">
          <p>
            A timeless black notebook, hand-foiled with your name, initials or your favorite quote.
            A personal gift to others or to yourself.
          </p>
          <p class="font-medium text-foreground">
            The perfect day-to-day tool, made extra special through calligraphy.
          </p>
        </div>
        <a href={productMailto} class={ctaClass}>Inquire about Personalised Notebooks</a>
      </div>
      <img
        src="/images/personalized-notebooks.jpg"
        alt="Personalised black notebook with Henry Calligraphy embossed in gold"
        class="order-1 aspect-[3/4] w-full object-cover object-center sm:aspect-auto sm:h-96 md:order-2 md:h-[28rem]"
      />
    </div>
  </section>
</Layout>
