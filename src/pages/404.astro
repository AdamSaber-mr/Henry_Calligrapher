---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Page not found — Henry Calligraphy"
  description="The page you're looking for doesn't exist or has been moved."
>
  <section>
    <div class="mx-auto flex max-w-6xl flex-col items-center px-5 py-section text-center sm:px-6" data-reveal>
      <p class="font-sans text-eyebrow uppercase tracking-[0.24em] text-muted-foreground">
        Error 404
      </p>
      <h1 class="mt-4 max-w-2xl text-balance font-serif text-display">Page not found</h1>
      <p class="mt-6 max-w-md font-sans text-lead text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4">
        <Button href="/" variant="accent" size="smMd">Back to home</Button>
        <Button href="/contact" variant="outline" size="smMd">Commission inquiry</Button>
      </div>
    </div>
  </section>
</Layout>
