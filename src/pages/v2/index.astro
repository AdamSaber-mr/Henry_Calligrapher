---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import Hero from '../../components/v2/Hero.astro';
import CredentialsStrip from '../../components/v2/CredentialsStrip.astro';
import ServiceCards from '../../components/v2/ServiceCards.astro';
import Section from '../../components/v2/Section.astro';
import FeatureSplit from '../../components/v2/FeatureSplit.astro';
import ProcessSteps from '../../components/v2/ProcessSteps.astro';
import ContactBanner from '../../components/v2/ContactBanner.astro';
import Faq from '../../components/v2/Faq.astro';
import InstagramGrid from '../../components/v2/InstagramGrid.astro';
import Button from '../../components/v2/Button.astro';
---

<LayoutV2
  title="Henry Calligraphy — Bespoke Copperplate Calligraphy in Breda"
  description="Hand-lettered wedding stationery, live event calligraphy, engraving and hot foil by Isha Henry-Hament, calligrapher based in Breda, the Netherlands."
>
  <Hero />
  {/* Four short facts add little on a phone and push the real content down. */}
  <CredentialsStrip class="hidden sm:block" />
  <ServiceCards />

  <Section>
    <div class="flex flex-col gap-14 lg:gap-20">
      <FeatureSplit
        eyebrow="At your event"
        title="Live calligraphy"
        file="live-waxseal.jpg"
        alt="Live calligraphy — pouring a wax seal onto a hand-lettered envelope"
        objectPosition="object-[50%_68%]"
      >
        On-site at your event: guests watch their names, bottles or bags being personalised in ink. A
        memorable detail for brand activations, weddings and private celebrations.
        <Fragment slot="cta">
          <Button href="/v2/previous-projects" variant="outline">See previous projects</Button>
        </Fragment>
      </FeatureSplit>

      <FeatureSplit
        eyebrow="From the studio"
        title="Studio orders"
        file="studio-orders.jpg"
        alt="Studio order — hand-lettered welcome card among fresh flowers"
        objectPosition="object-[65%_45%]"
        reversed
      >
        Written and finished in the studio, then delivered to your door: invitation suites, engraved
        gifts and foiled stationery, crafted at the pace good work requires.
        <Fragment slot="cta">
          <Button href="/v2/products" variant="outline">Browse products</Button>
        </Fragment>
      </FeatureSplit>
    </div>
  </Section>

  <ProcessSteps />
  <ContactBanner id="inquiry" />
  <InstagramGrid />
  <Faq />
</LayoutV2>
