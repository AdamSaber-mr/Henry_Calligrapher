---
import { Image } from 'astro:assets';
import LayoutV2 from '../../layouts/LayoutV2.astro';
import PageHeader from '../../components/v2/PageHeader.astro';
import Section from '../../components/v2/Section.astro';
import FeatureSplit from '../../components/v2/FeatureSplit.astro';
import Gallery from '../../components/v2/Gallery.astro';
import ReadMore from '../../components/v2/ReadMore.astro';
import { img } from '../../lib/images';

const hero = img('petalia-hero.jpg');
---

<LayoutV2
  title="Pétalia Collection — Henry Calligraphy"
  description="Pétalia: where flowers and calligraphy become one. Curated fine paper and card designs created from real pressed flowers."
>
  <PageHeader
    eyebrow="Botanical paper & cards"
    title="Pétalia Collection"
    lead="Where flowers and calligraphy become one."
    center
    divider={false}
  />

  {/* Portrait source in a landscape band, so the crop is weighted towards the cards on the
      wall rather than centring on the figure. The bottom padding keeps the photograph off the
      next section's rule, which it would otherwise sit flush against. */}
  <div class="mx-auto max-w-6xl px-5 pb-12 sm:px-6 sm:pb-16" data-reveal>
    <Image
      src={hero}
      alt="Isha arranging Pétalia pressed-flower cards on a panelled wall"
      widths={[640, 960, 1440, 1920]}
      sizes="(min-width: 1152px) 72rem, 100vw"
      class="aspect-[4/5] w-full rounded-2xl object-cover object-[42%_28%] sm:aspect-[3/2] lg:aspect-[2/1]"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <Section>
    <FeatureSplit
      eyebrow="The collection"
      title="Curated from real flowers"
      file="petalia-first.jpg"
      alt="Pétalia botanical Save the Date cards with a fresh rose"
      objectPosition="object-[62%_62%]"
      bodySize="base"
      reversed
    >
      <ReadMore maxHeight="13rem">
        <p>
          Pétalia is a curated collection of fine paper and card designs, created from real flowers
          that have been carefully pressed, preserved and composed by hand.
        </p>
        <p class="mt-4">
          Each botanical composition is thoughtfully arranged to capture the natural beauty, texture
          and character of the flowers. The original artwork is then meticulously scanned and
          transformed into refined, high-quality paper and card designs that can be reproduced.
        </p>
        <p class="mt-4">
          For a truly bespoke finish, each piece can be individually embellished with hand-applied
          calligraphy, creating a personal detail that makes every item feel considered and unique.
        </p>
        <p class="mt-4">
          Designed to elevate a space, a celebration or meaningful moment, Pétalia brings together the
          delicacy of real flowers with the timeless art of calligraphy.
        </p>
      </ReadMore>
    </FeatureSplit>
  </Section>

  {/* Both blocks are built identically — same ratio, same body size, no inline button —
      so neither reads as more important than the other.

      Both photographs were re-cut from the full-resolution brandshoot frames so they show
      more of the scene than the earlier tight crops did — the cards now sit whole on the wood
      instead of running out of frame. The files are exactly 3:2, so object-cover has nothing
      left to trim and no objectPosition is needed. */}
  <Section>
    <div class="flex flex-col gap-14 lg:gap-20">
      <FeatureSplit
        eyebrow="Made with you"
        title="Bespoke Pétalia designs"
        file="petalia-bespoke.jpg"
        alt="Bespoke Pétalia invitation cards with pressed pink carnations and copperplate calligraphy"
        ratio="aspect-[3/2]"
        bodySize="base"
      >
        <ReadMore maxHeight="9rem">
        <p class="font-medium text-foreground">
          You choose the flowers, I create the composition. Together, we make it yours.
        </p>
        <p class="mt-4">
          Select the flowers that hold meaning to you and leave the artistry to me. Together we will
          thoughtfully curate and compose your chosen blooms into a unique design.
        </p>
        <p class="mt-4">
          Once you've chosen your design, you can add bespoke calligraphy for a beautifully
          personalized finish – or keep the cards as they are and write your own message.
        </p>
        </ReadMore>
      </FeatureSplit>

      <FeatureSplit
        eyebrow="Made to keep"
        title="A lasting keepsake"
        file="petalia-keepsake.jpg"
        alt="Finished Pétalia botanical cards with copperplate calligraphy"
        ratio="aspect-[3/2]"
        bodySize="base"
        reversed
      >
        <ReadMore maxHeight="9rem">
        <p>
          Whether you choose calligraphy or add a handwritten note of your own, each Pétalia piece is
          designed to make your message feel as special as the flowers that inspired it.
        </p>
        <p class="mt-4">Your Pétalia piece can be framed and cherished as a lasting keepsake.</p>
        <p class="mt-4 font-medium text-foreground">
          Choose your favorite design from The Pétalia Collection, or create something entirely your
          own.
        </p>
        </ReadMore>
      </FeatureSplit>
    </div>
  </Section>

  <Section>
    <div class="text-center" data-reveal>
      <p class="font-sans text-eyebrow uppercase tracking-[0.24em] text-muted-foreground">
        The collection
      </p>
      <h2 class="mt-4 font-serif text-headline">Collection gallery</h2>
    </div>
    <Gallery />
  </Section>
</LayoutV2>
