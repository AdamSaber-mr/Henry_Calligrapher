---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';

const sections = [
  { id: 'introduction', heading: '1. Introduction' },
  { id: 'orders', heading: '2. Orders and quotes' },
  { id: 'payment', heading: '3. Payment' },
  { id: 'cancellations', heading: '4. Cancellations and refunds' },
  { id: 'turnaround', heading: '5. Turnaround and delivery' },
  { id: 'ip', heading: '6. Intellectual property' },
  { id: 'liability', heading: '7. Liability' },
  { id: 'changes', heading: '8. Changes to these terms' },
  { id: 'contact', heading: '9. Contact' },
];

const h2 = 'font-serif text-title text-foreground';
const link = 'text-foreground underline underline-offset-4 transition-colors hover:text-accent';
---

<Layout
  title="Terms and Conditions — Henry Calligraphy"
  description="Terms and conditions for using the Henry Calligraphy website and commissioning bespoke calligraphy services."
>
  <LegalPage title="Terms and Conditions" sections={sections} updated="4 September 2026">
    <section id="introduction">
      <h2 class={h2}>1. Introduction</h2>
      <p class="mt-4">
        These Terms and Conditions apply to your use of the Henry Calligraphy website and to any
        bespoke calligraphy, engraving, hot foil, or related services you commission from Henry
        Calligraphy. By using this website or placing an order, you agree to these terms.
      </p>
    </section>

    <section id="orders">
      <h2 class={h2}>2. Orders and quotes</h2>
      <p class="mt-4">
        All commissions are bespoke and begin with an enquiry. A final quote is provided based on
        the details of your project, including materials, quantity, complexity, and turnaround time.
        Quotes are valid for 14 days unless otherwise stated.
      </p>
    </section>

    <section id="payment">
      <h2 class={h2}>3. Payment</h2>
      <p class="mt-4">
        A deposit may be required to confirm your booking or commission. Full payment terms will be
        outlined in your quote or invoice. Work on custom pieces begins once the agreed deposit or
        payment has been received.
      </p>
    </section>

    <section id="cancellations">
      <h2 class={h2}>4. Cancellations and refunds</h2>
      <p class="mt-4">
        Because each item is made to order, cancellations and refunds are not guaranteed. If you
        need to cancel or amend an order, please contact us as soon as possible. Any refund or
        partial credit will be considered on a case-by-case basis and at our discretion.
      </p>
    </section>

    <section id="turnaround">
      <h2 class={h2}>5. Turnaround and delivery</h2>
      <p class="mt-4">
        Turnaround times are estimates and depend on project scope, material availability, and
        current workload. We will communicate expected timelines clearly and keep you informed of
        any changes. Delivery costs and methods are agreed before final payment.
      </p>
    </section>

    <section id="ip">
      <h2 class={h2}>6. Intellectual property</h2>
      <p class="mt-4">
        All calligraphy, designs, photographs, and content on this website are the property of Henry
        Calligraphy unless otherwise credited. Commissioned artwork is for personal or event use as
        agreed; commercial reproduction or resale without written permission is not allowed.
      </p>
    </section>

    <section id="liability">
      <h2 class={h2}>7. Liability</h2>
      <p class="mt-4">
        Henry Calligraphy takes great care in creating and packing every piece. Our liability is
        limited to the value of the commissioned work. We are not liable for delays or issues caused
        by circumstances beyond our reasonable control.
      </p>
    </section>

    <section id="changes">
      <h2 class={h2}>8. Changes to these terms</h2>
      <p class="mt-4">
        We may update these Terms and Conditions from time to time. The latest version will always
        be published on this page. Continued use of the website or our services after changes means
        you accept the updated terms.
      </p>
    </section>

    <section id="contact">
      <h2 class={h2}>9. Contact</h2>
      <p class="mt-4">
        For questions about these Terms and Conditions, please email <a
          href="mailto:info@henrycalligraphy.com"
          class={link}>info@henrycalligraphy.com</a
        >.
      </p>
    </section>
  </LegalPage>
</Layout>
